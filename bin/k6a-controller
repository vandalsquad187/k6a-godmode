#!/system/bin/sh
# k6a-controller  v2.7 — _TSTATE dynamisch | Cooldown konfigurierbar

MODDIR="${1:-/data/adb/modules/k6a_tune}"
CONFIG="$MODDIR/config/settings.conf"
LOG="$MODDIR/config/service.log"
DATA="$MODDIR/webroot/data.txt"
LOG_WEB="$MODDIR/webroot/log.txt"
GOD_FILE="$MODDIR/config/god_mode"
THP_FILE="$MODDIR/config/thermal_protect"
CRASH_FILE="$MODDIR/run/crash_count"
THERMAL_STATE_FILE="$MODDIR/run/thermal_state"
LOCK="$MODDIR/run/controller.pid"
LOG_FILE="$LOG"

. "$MODDIR/bin/k6a-lib.sh"

STATE="OFF"; TICK=0; _GOD=0; _THP=1; _TSTATE="active"; _WIFI_OLD=-1
LAST_LOG_TS=0; LOG_INTERVAL=30

cfg() { grep "^${1}=" "$CONFIG" 2>/dev/null | cut -d= -f2; }
set_cfg() {
    local key="$1" val="$2"
    if grep -q "^${key}=" "$CONFIG" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONFIG"
    else
        echo "${key}=${val}" >> "$CONFIG"
    fi
}

_cfg_load() {
    DEBUG=$(cfg debug); [ "$DEBUG" != "1" ] && DEBUG=0; CFG_DEBUG=$DEBUG
    CFG_THRESH=$(cfg thermal_cooking_thresh); CFG_THRESH=${CFG_THRESH:-78}
    [ "$CFG_THRESH" -lt 70 ] && CFG_THRESH=70; [ "$CFG_THRESH" -gt 95 ] && CFG_THRESH=95
    for _v in god_gpu god_sched god_io god_vm god_irq god_net god_props wifi_boost; do
        _upper=$(echo "$_v" | tr '[:lower:]' '[:upper:]')
        eval "CFG_${_upper}"=\"$(cfg "$_v")\"
        eval "[ \"\$CFG_${_upper}\" != \"0\" ] && CFG_${_upper}=1 || CFG_${_upper}=0"
    done
    for _cd in l2_temp l3_temp l4_temp recover_temp \
               l2_gold_max l3_gold_max l4_gold_max \
               l2_gpu_max l3_gpu_max l4_gpu_max; do
        _upper=$(echo "$_cd" | tr '[:lower:]' '[:upper:]')
        eval "CD_${_upper}"=\"$(cfg "cooldown_${_cd}")\"
    done
    : "${CD_L2_TEMP:=76}"    "${CD_L3_TEMP:=80}"    "${CD_L4_TEMP:=85}"    "${CD_RECOVER_TEMP:=72}"
    : "${CD_L2_GOLD_MAX:=1600000}" "${CD_L3_GOLD_MAX:=1400000}" "${CD_L4_GOLD_MAX:=1200000}"
    : "${CD_L2_GPU_MAX:=565000000}"   "${CD_L3_GPU_MAX:=430000000}"   "${CD_L4_GPU_MAX:=355000000}"
}

_ratelog() {
    local now; now=$(date +%s)
    [ $(( now - LAST_LOG_TS )) -ge "$LOG_INTERVAL" ] && { LAST_LOG_TS=$now; log "$1"; }
}

_trim_log() {
    [ -f "$LOG" ] || return
    local lines; lines=$(wc -l < "$LOG" 2>/dev/null) || return
    [ "$lines" -gt 500 ] && tail -n 300 "$LOG" > "${LOG}.tmp" && mv "${LOG}.tmp" "$LOG"
}

_god_on() {
    log "-> GOD-MODE ON"; _cfg_load
    _TSTATE="active"
    echo "$_TSTATE" > "$THERMAL_STATE_FILE" 2>/dev/null || true
    cpu_hotplug_online_all
    [ "$_THP" = "1" ] && lmh_disable
    [ "$_THP" = "1" ] && thermal_disable
    cpu_gaming
    [ "$CFG_GOD_GPU" = "1" ]   && gpu_gaming
    [ "$CFG_GOD_IO" = "1" ]    && io_gaming
    [ "$CFG_GOD_SCHED" = "1" ] && sched_gaming
    [ "$CFG_GOD_VM" = "1" ]    && vm_gaming
    [ "$CFG_GOD_IRQ" = "1" ]   && apply_irq_affinity
    [ "$CFG_GOD_NET" = "1" ]   && net_gaming
    [ "$CFG_WIFI_BOOST" = "1" ] && net_wifi_boost
    [ "$CFG_GOD_PROPS" = "1" ] && props_gaming
    lru_gen_enable
    wakelock_block
    tune_gaming
    STATE="GAMING"
    local active=""
    [ "$CFG_GOD_GPU" = "1" ]   && active="${active}gpu "
    [ "$CFG_GOD_SCHED" = "1" ] && active="${active}sched "
    [ "$CFG_GOD_IO" = "1" ]    && active="${active}io "
    [ "$CFG_GOD_VM" = "1" ]    && active="${active}vm "
    [ "$CFG_GOD_IRQ" = "1" ]   && active="${active}irq "
    [ "$CFG_GOD_NET" = "1" ]   && active="${active}net "
    [ "$CFG_WIFI_BOOST" = "1" ] && active="${active}wifi "
    [ "$CFG_GOD_PROPS" = "1" ] && active="${active}props "
    log "mode: $(r "$GOD_FILE") | active: ${active}"
}

_do_cooldown() {
    local temp=$1
    if [ "$temp" -ge "${CD_L4_TEMP:-85}" ] 2>/dev/null; then
        gpu_cooldown 4 "${CD_L4_GPU_MAX:-355000000}"
        w "$P6/scaling_max_freq" "${CD_L4_GOLD_MAX:-1200000}"
        _TSTATE="cooldown_l4"
        echo "$_TSTATE" > "$THERMAL_STATE_FILE" 2>/dev/null || true
        _ratelog "Cooldown L4 ($temp>=${CD_L4_TEMP}C): GPU ${CD_L4_GPU_MAX} Gold ${CD_L4_GOLD_MAX}kHz"
    elif [ "$temp" -ge "${CD_L3_TEMP:-80}" ] 2>/dev/null; then
        gpu_cooldown 3 "${CD_L3_GPU_MAX:-430000000}"
        w "$P6/scaling_max_freq" "${CD_L3_GOLD_MAX:-1400000}"
        _TSTATE="cooldown_l3"
        echo "$_TSTATE" > "$THERMAL_STATE_FILE" 2>/dev/null || true
        _ratelog "Cooldown L3 ($temp>=${CD_L3_TEMP}C): GPU ${CD_L3_GPU_MAX} Gold ${CD_L3_GOLD_MAX}kHz"
    elif [ "$temp" -ge "${CD_L2_TEMP:-76}" ] 2>/dev/null; then
        gpu_cooldown 2 "${CD_L2_GPU_MAX:-565000000}"
        w "$P6/scaling_max_freq" "${CD_L2_GOLD_MAX:-1600000}"
        _TSTATE="cooldown_l2"
        echo "$_TSTATE" > "$THERMAL_STATE_FILE" 2>/dev/null || true
        _ratelog "Cooldown L2 ($temp>=${CD_L2_TEMP}C): GPU ${CD_L2_GPU_MAX} Gold ${CD_L2_GOLD_MAX}kHz"
    elif [ "$temp" -le "${CD_RECOVER_TEMP:-72}" ] 2>/dev/null; then
        gpu_gaming
        w "$P6/scaling_max_freq" 1804800
        _TSTATE="active"
        echo "$_TSTATE" > "$THERMAL_STATE_FILE" 2>/dev/null || true
        _ratelog "Cooldown off: ${temp}C"
    fi
}

_write_data() {
    local temp cpu_s cpu_g gpu_mhz gpu_busy bpc btp btpc
    temp=$(thermal_cpu_temp)
    cpu_s=$(( $(r "$P0/scaling_cur_freq") / 1000 ))
    cpu_g=$(( $(r "$P6/scaling_cur_freq") / 1000 ))
    gpu_mhz=$(( $(r "$GPU/devfreq/cur_freq") / 1000000 ))
    gpu_busy=$(r "$GPU/gpu_busy_percentage" | grep -o '[0-9.]*' | head -1)
    bpc=$(r /sys/class/power_supply/battery/capacity)
    btp=$(r /sys/class/power_supply/battery/temp)
    btpc="$(( btp / 10 )).$(( btp % 10 ))"
    local uptime_str ram_total ram_avail ram_used
    uptime_str=$(uptime 2>/dev/null | sed 's/.*up //' | sed 's/,.*//' | xargs)
    ram_total=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
    ram_avail=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{print $2}')
    ram_used=$(( (ram_total - ram_avail) / 1024 ))
    ram_total=$(( ram_total / 1024 ))
    local kv
    kv=$(uname -r 2>/dev/null || echo "unknown")
    kv2=$(uname -v 2>/dev/null || echo "unknown")
    _tmp="$DATA.$$.tmp"
    : > "$_tmp"
    printf 'pid=%s\n' "$$" >> "$_tmp"
    printf 'modpath=%s\n' "$MODDIR" >> "$_tmp"
    printf 'state=%s\n' "$STATE" >> "$_tmp"
    printf 'god_mode=%s\n' "$_GOD" >> "$_tmp"
    printf 'thermal_protect=%s\n' "$_THP" >> "$_tmp"
    printf 'thermal_state=%s\n' "$_TSTATE" >> "$_tmp"
    printf 'god_gpu=%s\n' "$CFG_GOD_GPU" >> "$_tmp"
    printf 'god_sched=%s\n' "$CFG_GOD_SCHED" >> "$_tmp"
    printf 'god_io=%s\n' "$CFG_GOD_IO" >> "$_tmp"
    printf 'god_vm=%s\n' "$CFG_GOD_VM" >> "$_tmp"
    printf 'god_irq=%s\n' "$CFG_GOD_IRQ" >> "$_tmp"
    printf 'god_net=%s\n' "$CFG_GOD_NET" >> "$_tmp"
    printf 'god_props=%s\n' "$CFG_GOD_PROPS" >> "$_tmp"
    printf 'wifi_boost=%s\n' "$CFG_WIFI_BOOST" >> "$_tmp"
    printf 'temp=%s\n' "${temp}" >> "$_tmp"
    printf 'cpu_sil_mhz=%s\n' "${cpu_s}" >> "$_tmp"
    printf 'cpu_gold_mhz=%s\n' "${cpu_g}" >> "$_tmp"
    printf 'gpu_mhz=%s\n' "${gpu_mhz}" >> "$_tmp"
    printf 'gpu_busy=%s\n' "${gpu_busy}" >> "$_tmp"
    printf 'bat=%s\n' "${bpc}%" >> "$_tmp"
    printf 'bat_temp=%s\n' "${btpc}" >> "$_tmp"
    printf 'kernel=%s\n' "${kv}" >> "$_tmp"
    printf 'kernel_v=%s\n' "${kv2}" >> "$_tmp"
    printf 'uptime=%s\n' "${uptime_str}" >> "$_tmp"
    printf 'ram_used=%s\n' "${ram_used}" >> "$_tmp"
    printf 'ram_total=%s\n' "${ram_total}" >> "$_tmp"
    printf 'tick=%s\n' "${TICK}" >> "$_tmp"
    printf 'features=hotplug=%s lru=%s boeffla=%s uclamp=%s thermal_w=%s\n' "${FEATURE_HOTPLUG}" "${FEATURE_LRU_GEN}" "${FEATURE_BOEFFLA}" "${FEATURE_UCLAMP}" "${FEATURE_THERMAL_WRITABLE}" >> "$_tmp"
    printf 'gov_sil=%s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)" >> "$_tmp"
    printf 'gov_gold=%s\n' "$(cat /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor 2>/dev/null)" >> "$_tmp"
    printf 'gov_gpu=%s\n' "$(cat /sys/class/kgsl/kgsl-3d0/devfreq/governor 2>/dev/null)" >> "$_tmp"
    printf 'cpu_sil_max=%s\n' "$(($(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null) / 1000))" >> "$_tmp"
    printf 'cpu_gold_max=%s\n' "$(($(cat /sys/devices/system/cpu/cpu6/cpufreq/scaling_max_freq 2>/dev/null) / 1000))" >> "$_tmp"
    mv "$_tmp" "$DATA"
    tail -30 "$LOG" > "$LOG_WEB" 2>/dev/null || true
}
LOCKDIR="$MODDIR/run/lock"

_startup() {
    if ! mkdir -p "$LOCKDIR" 2>/dev/null; then
        if [ -f "$LOCKDIR/pid" ]; then
            _old_pid=$(cat "$LOCKDIR/pid" 2>/dev/null)
            if [ -n "$_old_pid" ] && kill -0 "$_old_pid" 2>/dev/null; then
                if grep -q "k6a-controller" /proc/"$_old_pid"/cmdline 2>/dev/null; then
                    err "Controller already running (PID $_old_pid)"
                    exit 1
                fi
                err "Stale lock: PID $_old_pid belongs to $(tr '\0' ' ' < /proc/$_old_pid/cmdline 2>/dev/null), removing"
            else
                err "Stale lock: PID $_old_pid is dead, removing"
            fi
        fi
        rm -rf "$LOCKDIR"
        mkdir -p "$LOCKDIR" || exit 1
    fi
    # Crash counter with backoff
    _CRASH_PREV=$(cat "$CRASH_FILE" 2>/dev/null || echo 0)
    _CRASH_NEW=$(( _CRASH_PREV + 1 ))
    echo "$_CRASH_NEW" > "$CRASH_FILE"
    if [ "$_CRASH_NEW" -gt 3 ]; then
        log "Crash-Limit (${_CRASH_NEW}), sleep 30s"
        sleep 30
    fi
    echo $$ > "$LOCKDIR/pid"
    _cfg_load; _cache_thermal_zones
    detect_kernel_features
    thermal_trips_restore
    echo "active" > "$THERMAL_STATE_FILE" 2>/dev/null || true
    printf 'pid=%s\nstate=OFF\ngod_mode=0\n' "$$" > "$DATA" 2>/dev/null || true
    log "k6a-godmode v2.7 - _TSTATE dynamic | Cooldown configurable"
}

trap 'echo 0 > "$CRASH_FILE" 2>/dev/null; log "Controller stopped"; thermal_trips_restore; rm -rf "$LOCKDIR"
' EXIT TERM INT

_startup
while true; do
    _god=$(r "$GOD_FILE")
    _thp=$(r "$THP_FILE")
    [ "$_god" != "0" ] && _god=1 || _god=0
    [ "$_thp" != "0" ] && _thp=1 || _thp=0
    [ "$_GOD" != "$_god" ] && { _GOD=$_god; log "god_mode=${_GOD}"; }
    [ "$_THP" != "$_thp" ] && { _THP=$_thp; log "thermal_protect=${_THP}"; }

    if [ "$_GOD" = "1" ]; then
        if [ "$STATE" != "GAMING" ]; then
            _god_on
        else
            [ $(( TICK % 5 )) -eq 0 ] && tune_gaming
            [ $(( TICK % 5 )) -eq 0 ] && gpu_adaptive
            [ $(( TICK % 10 )) -eq 0 ] && _cfg_load
            if [ "$_THP" = "1" ]; then
                _temp=$(thermal_cpu_temp)
                [ "$_temp" -ge "$CFG_THRESH" ] 2>/dev/null && _do_cooldown "$_temp"
            fi
            [ $(( TICK % 10 )) -eq 0 ] && {
                for _if in $(ip link show up 2>/dev/null | grep -o "wlan[0-9]*"); do timeout 3 iw dev "$_if" set power_save off 2>/dev/null || true; done
                timeout 5 fstrim /data 2>/dev/null || true
            }
        fi
    else
        [ "$STATE" != "OFF" ] && { STATE="OFF"; _TSTATE="off"; log "God-Mode OFF"; }
    fi

    TICK=$(( TICK + 1 ))
    [ $(( TICK % 3 )) -eq 0 ] && _write_data
    [ $(( TICK % 100 )) -eq 0 ] && _trim_log
    _WIFI=$(cfg wifi_boost)
    [ "$_WIFI" != "0" ] && _WIFI=1 || _WIFI=0
    if [ "$_WIFI" != "$_WIFI_OLD" ] 2>/dev/null; then
        if [ "$_WIFI" = "1" ]; then
            echo bbr > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || true
            log "WiFi Boost: ON (bbr)"
        else
            echo cubic > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || true
            log "WiFi Boost: OFF (cubic)"
        fi
        _WIFI_OLD=$_WIFI
    fi
    sleep 1
done
